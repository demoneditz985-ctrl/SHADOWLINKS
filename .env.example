# ══════════════════════════════════════════════════════════════════════════
#  SHADOWLINKS configuration
#  Copy to `.env` and fill in. Everything has a sane default except the two
#  marked REQUIRED.
# ══════════════════════════════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────────────────────────
# From @BotFather -> /newbot
BOT_TOKEN=123456789:AAExampleReplaceMeWithYourRealBotToken

# Your Telegram user id (get it from @userinfobot). Comma separate for several.
# Admins are permanently VIP and can use the whole admin panel.
ADMIN_IDS=111111111


# ── presentation ───────────────────────────────────────────────────────────
BOT_NAME=SHADOWLINKS
# Bot username people should DM to buy/renew VIP (no @)
SUPPORT_USERNAME=
# Pinned channel link, shown on /start
CHANNEL_URL=
PRICE_LINE=VIP = unlimited resolves, no cooldown, batch mode, full redirect chain.


# ── free vs VIP limits ─────────────────────────────────────────────────────
FREE_DAILY_LIMIT=5      # resolves per day for non-VIP
FREE_COOLDOWN=45        # seconds a free user must wait between links
FREE_BATCH_LIMIT=0      # 0 = batch mode is VIP-only
VIP_DAILY_LIMIT=0       # 0 = unlimited
VIP_BATCH_LIMIT=25      # max links per batch message


# ── resolver tuning ────────────────────────────────────────────────────────
MAX_HOPS=14             # redirect chain depth ceiling
HTTP_TIMEOUT=35         # seconds per request
GOLINK_DELAY=10         # anti-bot timer wait, in seconds
FORM_RETRIES=2          # extra POST attempts after a timer rejection
ADAPTIVE_DELAY=1        # learn each site's timer so the happy path stays fast
MAX_CONCURRENCY=8       # resolves in flight at once
RESOLVE_CHAINS=1        # keep walking shortener -> ad-gate -> shortener -> final


# ── HTTP backend ───────────────────────────────────────────────────────────
USE_CURL_CFFI=1         # 0 forces the aiohttp fallback (no TLS impersonation)
IMPERSONATE=chrome      # curl_cffi fingerprint: chrome, safari, edge, firefox


# ── extending the shortener table WITHOUT editing code ─────────────────────
# Comma separated hostnames, merged into the built-in registry at boot.
# A new GPLinks mirror appeared? Just add it here and restart.
EXTRA_GPLINKS_DOMAINS=
EXTRA_FORM_DOMAINS=
EXTRA_REDIRECT_DOMAINS=
EXTRA_ADFLY_DOMAINS=


# ── storage / ops ──────────────────────────────────────────────────────────
DB_PATH=shadowlinks.db
LOG_RESOLVES=1          # keep per-request rows for /logs and /stats
LOG_LEVEL=INFO          # DEBUG shows every redirect hop


# ── security ───────────────────────────────────────────────────────────────
# Leave at 0. Setting 1 lets the bot fetch private/loopback addresses, which
# turns it into an SSRF probe against your own network.
ALLOW_PRIVATE_NETWORKS=0
MAX_BODY_BYTES=2000000

# Show the full redirect chain to free users too (VIP perk if 0)
SHOW_CHAIN_TO_FREE=0
